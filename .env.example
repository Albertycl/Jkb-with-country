# Existing MariaDB container (see docker-compose.yml). Create the database and user once:
#   CREATE DATABASE jkb_with_country; CREATE USER 'jkb'@'%' IDENTIFIED BY '<password>';
#   GRANT ALL ON jkb_with_country.* TO 'jkb'@'%';
MYSQL_HOST=netdiag-mariadb-1
MYSQL_PORT=3306
MYSQL_DATABASE=jkb_with_country
MYSQL_USER=jkb
MYSQL_PASSWORD=change-me
FRONTEND_PORT=5436

# Demo mode: pollers off, data comes from demo/seed_demo_data.sql
ENABLE_POLLERS=false
# Only needed when ENABLE_POLLERS=true (real JianKongBao / Cedexis / infra lookup)
JKB_USER_EMAIL=
JKB_USER_PWD=
JKB_CLIENT_ID=
JKB_CLIENT_SECRET=
CEDEXIS_TOKEN=
INFRA_LOOKUP_URL=

# Reload demo data on every start. Set to false when ENABLE_POLLERS=true (a restart would wipe polled data).
SEED_DEMO_DATA=true
